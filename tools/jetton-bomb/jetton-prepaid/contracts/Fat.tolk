import "messages"

// Fat — a "fat-state" load target: an account born (in the zerostate) with a large, unique storage
// dict, so that every time the collator touches it, it must walk that dict for the storage-stat /
// full-collated-data proof (`prelim_storage_stat` — the collation-TIME axis that drove the mainnet
// long_collation shard splits). Thousands of these are generated by ton/benchmark/state-gen.cpp
// (AccountType::Fat) at raw addresses SHA256(seed | "fat" | i); go-spam then sends real jetton
// transfers TO them (op::transfer with forward_ton > 0), so each transfer's TransferNotification lands
// on the fat and forces the walk.
//
// The mutation lever: a StorageStatCache keys on the storage hash, so an unchanged fat is walked once
// and then cached. The FIRST BIT of the notification's forwardPayload is a mutate flag — when set, the
// fat bumps a nonce (changing the storage hash) so the next collation re-walks the whole tree. Sending
// with the flag on vs off is an A/B on whether the walk is actually cached away.
//
// Storage (must byte-match build_fat_storage in state-gen.cpp): nonce:uint64 | ^bigDict.
// The contract holds bigDict opaquely; it is the generator that fills it with unique cells.

const OP_TRANSFER_NOTIFICATION = 0x7362d09c

struct FatStorage {
    nonce: uint64
    bigDict: cell
}

fun FatStorage.load(): FatStorage {
    return FatStorage.fromCell(contract.getData());
}

fun FatStorage.save(self) {
    contract.setData(self.toCell());
}

contract Fat {
    author: "@vimlover"
    version: "1.0.0"
    description: "Fat-state load target: large storage dict, mutates on a flagged transfer notification"
    storage: FatStorage
    incomingMessages: TransferNotificationForRecipient
}

fun onInternalMessage(in: InMessage) {
    // React only to jetton transfer notifications; silently accept anything else (plain GRAM
    // top-ups, stray messages) instead of throwing, so a fat never bounces load back at a sender.
    var probe = in.body;
    if (probe.remainingBitsCount() < 32) {
        return;
    }
    if (probe.loadUint(32) != OP_TRANSFER_NOTIFICATION) {
        return;
    }

    val notif = lazy TransferNotificationForRecipient.fromSlice(in.body);

    // forwardPayload is the raw (Either-tagged) remainder; its FIRST bit is our mutate flag:
    //   go-spam sends a non-empty forwardPayload (ref form => leading bit 1) to request a mutation,
    //   or an empty one (inline => leading bit 0) to just touch-without-mutating.
    var fp = notif.forwardPayload;
    val mutateFlag = fp.remainingBitsCount() >= 1 ? fp.loadUint(1) : 0;
    if (mutateFlag != 0) {
        var storage = FatStorage.load();
        storage.nonce += 1;
        storage.save();
    }
}

get fun get_nonce(): int {
    return FatStorage.load().nonce;
}
